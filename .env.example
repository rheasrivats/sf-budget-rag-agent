# Optional but recommended for tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# Required if you use OpenAI for chat + embeddings
OPENAI_API_KEY=

# Required for retrieval reranking
COHERE_API_KEY=

# Optional CRAG web supplementation for low-confidence Q&A retrieval
TAVILY_API_KEY=
CRAG_ENABLED=true
CRAG_ADEQUACY_CHECK_ENABLED=true
CRAG_RERANK_THRESHOLD=0.35
CRAG_ADEQUACY_MAX_CHUNKS=5
CRAG_ADEQUACY_CHUNK_CHARS=700
CRAG_TAVILY_MAX_RESULTS=5
CRAG_ALLOWED_DOMAINS=sf.gov,media.api.sf.gov,gov

# Optional model routing overrides
RAG_PLANNER_MODEL=gpt-5.4
RAG_PLANNER_REASONING_EFFORT=high
RAG_CHAT_MINI_MODEL=gpt-5.4-mini
RAG_QA_REASONING_EFFORT=low
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_RETRIEVER_K=8
RAG_RERANK_MODEL=rerank-v4.0-pro
RAG_RERANK_CANDIDATE_POOL=8

# Local persistence
DATABASE_URL=sqlite:///./research_agent.db
